      "css": ":host{--m0:#0D0716;--m3:#641A80;--m4:#8C2981;--m5:#B73779;--m6:#DE4968;--m8:#FE9F6D;--m9:#FECF92;--field:#0D0716;--field-ink:#F6EFF4;--field-ink-2:#D8C9DD;--field-muted:#A898B1;--field-rule:rgba(252,253,191,.14);--ground:#FAF9FB;--ink:#1A1024;--ink-2:#44384F;--muted:#675B71;--rule:#E2DDE8;--rule-strong:#C9C0D3;--r:2px;--sans:'Archivo',ui-sans-serif,system-ui,sans-serif;--mono:'Martian Mono',ui-monospace,Menlo,monospace;--ease-out:cubic-bezier(.16,1,.3,1);font-family:var(--sans);} .ds-flag{font-stretch:118%;font-weight:620;font-size:.66rem;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-2);padding:2px 7px;border:1px solid var(--rule-strong);border-radius:var(--r);}"
    },
    {
