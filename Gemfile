source "https://rubygems.org"

# Matches the Jekyll version and plugins GitHub Pages uses to build this site.
# Preview locally with:  bundle install && bundle exec jekyll serve --livereload
gem "github-pages", group: :jekyll_plugins
gem "webrick"

# Ruby 3.4+ no longer bundles these; Jekyll 3.x still needs them.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
